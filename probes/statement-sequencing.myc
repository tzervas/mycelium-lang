// @probe: statement-sequencing
// @capability: imperative statement sequencing (`let a = …; let b = …; b`) with no `in`
// @expect-check: 65
// @expect-run: 65
// @claim: the TRUE content of the "multi-statement bodies" gap
// @note: Mycelium has exactly ONE sequencing production: `let PAT = EXPR in TAIL`. There is no
// @note: brace block-expression and no `;`-separated statement form.
// @note: Observed: error[myc-parse]: expected `in` after the let binding, found Semi.
// @note: So this is an ERGONOMICS/grammar gap, not an expressiveness cliff — sequencing IS
// @note: possible (see let-chain-effectful), just only in one spelling.
nodule probe;

fn main() => Binary{8} =
  let a = 0b0000_0001;
  let b = 0b0000_0010;
  b;
